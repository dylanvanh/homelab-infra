apiVersion: v1
kind: Secret
metadata:
  name: investec-secret
type: Opaque
stringData:
  INVESTEC_X_API_KEY: "REPLACE_WITH_INVESTEC_X_API_KEY"
  INVESTEC_CLIENT_ID: "REPLACE_WITH_INVESTEC_CLIENT_ID"
  INVESTEC_CLIENT_SECRET: "REPLACE_WITH_INVESTEC_CLIENT_SECRET"
  GEMINI_API_KEY: "REPLACE_WITH_GEMINI_API_KEY"
  GEMINI_MODEL: "gemini-2.5-flash"
  GOOGLE_SEARCH_API_KEY: "REPLACE_WITH_GOOGLE_SEARCH_API_KEY"
  GOOGLE_SEARCH_ENGINE_ID: ""
  OLLAMA_MODEL: "tinyllama:latest"
  CITY: "cape town"
  DATABASE_URL: "REPLACE_WITH_DATABASE_URL"

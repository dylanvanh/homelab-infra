apiVersion: v1
kind: Secret
metadata:
  name: pixel-pythons-secrets
type: Opaque
stringData:
  ORDISCAN_API_KEY: "REPLACE_WITH_ORDISCAN_API_KEY"
  ORACLE_PRIVATE_KEY_WIF: "REPLACE_WITH_ORACLE_PRIVATE_KEY_WIF"
  ORACLE_COMPRESSED_PUBLIC_KEY: "your_oracle_compressed_public_key_here"
  ORACLE_TAPROOT_ADDRESS: "your_oracle_taproot_address_here"
  SUPABASE_URL: "https://your-project-id.supabase.co"
  SUPABASE_SERVICE_ROLE_KEY: "your_supabase_service_role_key_here"


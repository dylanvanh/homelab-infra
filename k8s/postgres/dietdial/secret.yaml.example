apiVersion: v1
kind: Secret
metadata:
  name: dietdial-postgres-credentials
  namespace: default
type: kubernetes.io/basic-auth
stringData:
  username: dietdial
  password: "REPLACE_WITH_PASSWORD"
---
apiVersion: v1
kind: Secret
metadata:
  name: dietdial-postgres-tunnel
  namespace: default
stringData:
  TUNNEL_TOKEN: "REPLACE_WITH_TUNNEL_TOKEN"
---
apiVersion: v1
kind: Secret
metadata:
  name: dietdial-backup-token
  namespace: default
stringData:
  BACKUP_URL: https://dietdial-db-backups.dylanvanh45.workers.dev
  BACKUP_TOKEN: "REPLACE_WITH_BACKUP_TOKEN"
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-server-ca
  namespace: default
  labels:
    cnpg.io/reload: "true"
type: Opaque
stringData:
  ca.crt: REPLACE_WITH_SERVER_CA_CERTIFICATE
  ca.key: "REPLACE_WITH_CA_KEY"

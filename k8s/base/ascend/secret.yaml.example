apiVersion: v1
kind: Secret
metadata:
  name: ascend-secret
type: Opaque
stringData:
  DATABASE_URL: "postgresql://user:password@host/ascend?sslmode=require"
  OPENCODE_BASE_URL: "http://replace-with-private-host:4096"
  SESSION_SECRET: "replace-with-openssl-rand-base64-32"
  STRAVA_CLIENT_ID: ""
  STRAVA_CLIENT_SECRET: ""

apiVersion: v1
kind: Secret
metadata:
  name: ascend-secret
type: Opaque
stringData:
  DATABASE_URL: "REPLACE_WITH_DATABASE_URL"
  OPENCODE_BASE_URL: "http://replace-with-private-host:4096"
  SESSION_SECRET: "REPLACE_WITH_SESSION_SECRET"
  STRAVA_CLIENT_ID: "REPLACE_WITH_STRAVA_CLIENT_ID"
  STRAVA_CLIENT_SECRET: "REPLACE_WITH_STRAVA_CLIENT_SECRET"

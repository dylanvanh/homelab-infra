apiVersion: v1
kind: Secret
metadata:
  name: sidebet-secret
type: Opaque
stringData:
  DATABASE_URL: "REPLACE_WITH_DATABASE_URL"
  BETTER_AUTH_SECRET: "REPLACE_WITH_BETTER_AUTH_SECRET"
  DISCORD_SERVICE_TOKEN: "REPLACE_WITH_DISCORD_SERVICE_TOKEN"
  DISCORD_PUBLIC_KEY: "REPLACE_WITH_DISCORD_APPLICATION_PUBLIC_KEY"

apiVersion: v1
kind: Secret
metadata:
  name: sidebet-secret
type: Opaque
stringData:
  DATABASE_URL: "postgresql://app:POSTGRES_APP_PASSWORD@postgres-rw:5432/sidebet"
  BETTER_AUTH_SECRET: "REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
  DISCORD_SERVICE_TOKEN: "REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
  DISCORD_PUBLIC_KEY: "REPLACE_WITH_DISCORD_APPLICATION_PUBLIC_KEY"
